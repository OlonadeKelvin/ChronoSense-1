** sch_path: /foss/designs/Hei_Chips/ChronoSense-1/macros/heichips26_chronosense/testbenches/xschem/tb_core.sch
**.subckt tb_core
x1 out net3 net2 net1 0 chronosense_core
V2 net2 0 0.6
V3 net1 0 1.08
R1 net3 0 22000
**** begin user architecture code


.lib $PDKPATH/libs.tech/ngspice/models/cornerMOSlv.lib mos_ff
.lib $PDKPATH/libs.tech/ngspice/models/cornerRES.lib res_typ
.lib $PDKPATH/libs.tech/ngspice/models/cornerCAP.lib cap_typ
.temp 27
.param VDD=1.08 VREF=0.6 CT=15p
.ic v(x1.ctn)=0.5400
.options method=gear reltol=1e-4 itl4=100
.tran 5e-10 6.6e-06 0 5e-10
.control
run
meas tran t20  TRIG v(out) VAL=0.5400 RISE=5 TARG v(out) VAL=0.5400 RISE=25
meas tran vmax MAX v(x1.ctn) FROM=3.96e-06 TO=5.28e-06
meas tran vmin MIN v(x1.ctn) FROM=3.96e-06 TO=5.28e-06
meas tran vpad AVG v(net3) FROM=3.96e-06 TO=5.28e-06
echo "PVT mos_ff 1.08 27 res_typ cap_typ 22000 $&t20 $&vmax $&vmin $&vpad"
quit
.endc


**** end user architecture code
**.ends

